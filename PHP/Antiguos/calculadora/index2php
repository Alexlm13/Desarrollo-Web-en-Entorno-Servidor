<?php
//Si he recibido los valores...
if (isset($_GET['accion'])) {

    // Tomo los valores
    // La operacion que quiero realizar
    $operador = $_GET['accion'];
    //Los operandos
    $n1 = $_GET['n1'];
    $n2 = $_GET['n2'];

    //preguntamos por el valor de accion, la operacion que vamos a efectuar
    switch ($operador) {
        case "+":
            $res = $n1 + $n2;
            break;
        case "-":
            $res = $n1 - $n2;
            break;
        case "*":
            $res = $n1 * $n2;
            break;
        case "/":
            if ($n2 == 0) {
                $res = "No se puede realizar esta operación";
            }else{
                $res = $n1 / $n2;
            }
            break;
    }
}


?>
